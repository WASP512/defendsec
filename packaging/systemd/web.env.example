# Copy to /etc/defendsec/web.env and adjust.
#
# HTTPS is the default (roadmap 5.3). Leaving DEFENDSEC_TLS unset serves HTTPS
# with a self-signed certificate generated on first start — the browser warns,
# which is honest, and it is still strictly better than plain HTTP, where the
# admin token is readable by anything on the path.

# on    — self-signed, generated locally. The default.
# acme  — Let's Encrypt. Needs a public DNS name and inbound port 80.
# file  — a certificate you supply, from an internal CA.
# off   — plain HTTP. Isolated labs only, and logged loudly at every start.
# DEFENDSEC_TLS=on

# Names the certificate should cover: the hostname and IP operators use.
# Loopback is always included, so you can reach the console from the box even
# when DNS is wrong.
DEFENDSEC_TLS_HOSTS=defendsec.example.com,192.168.1.50

# Where HTTPS listens. This is the port operators, bookmarks and the agent
# installer already use, now serving HTTPS. Use :443 for the default port —
# the unit already grants CAP_NET_BIND_SERVICE.
DEFENDSEC_WEB_ADDR=:47261

# Optional plain-HTTP port that redirects to HTTPS. Unset means no redirector,
# which is fine; it cannot share the HTTPS port. Required as :80 for ACME,
# because http-01 challenges are answered there by definition.
# DEFENDSEC_WEB_HTTP_ADDR=:80

# The console itself, on loopback behind this front-end.
DEFENDSEC_CONSOLE_UPSTREAM=http://127.0.0.1:47265

# Where the generated certificate and ACME cache are kept.
DEFENDSEC_TLS_DIR=/var/lib/defendsec/tls

# --- ACME only ---
# DEFENDSEC_ACME_ACCEPT_TOS=1
# DEFENDSEC_ACME_EMAIL=security@example.com

# --- file only ---
# DEFENDSEC_TLS_CERT=/etc/defendsec/tls/console.crt
# DEFENDSEC_TLS_KEY=/etc/defendsec/tls/console.key
