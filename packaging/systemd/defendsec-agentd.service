[Unit]
Description=DefendSec mTLS host agent
After=network-online.target defendsec-apid.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/defendsec/agentd.env
ExecStart=/usr/local/bin/defendsec-agentd \
  -state-dir /var/lib/defendsec-agent \
  -apid https://127.0.0.1:47262
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
