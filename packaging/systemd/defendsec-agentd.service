[Unit]
Description=DefendSec mTLS host agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is required to read what the agent reports without changing anything:
# the package manager's state and repository metadata, configuration files the
# check packs read, and the file-integrity paths. It loads no kernel program
# and sends no process telemetry.
User=root
# Copy packaging/systemd/agentd.env.example → /etc/defendsec/agentd.env
EnvironmentFile=/etc/defendsec/agentd.env
ExecStart=/usr/local/bin/defendsec-agentd \
  -server-http ${DEFENDSEC_SERVER_HTTP} \
  -server-grpc ${DEFENDSEC_SERVER_GRPC} \
  -tls-server-name ${DEFENDSEC_TLS_SERVER_NAME} \
  -enroll-secret-file /etc/defendsec/enroll-secret \
  -state-dir /var/lib/defendsec-agent
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
