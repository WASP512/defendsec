# defendsec-agentd — endpoint agent
[Unit]
Description=DefendSec endpoint agent (mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/defendsec-agent
ExecStart=/usr/local/bin/defendsec-agentd --server-http https://CONTROL_PLANE:47262 --server-grpc CONTROL_PLANE:47263 --enroll-secret-file /etc/defendsec/enroll-secret --state-dir /var/lib/defendsec-agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/defendsec-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
