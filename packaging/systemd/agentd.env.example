# Copy to /etc/defendsec/agentd.env and adjust.
DEFENDSEC_SERVER_HTTP=https://127.0.0.1:47262
DEFENDSEC_SERVER_GRPC=127.0.0.1:47263
# Must match a SAN on the apid TLS certificate (often the LAN hostname or IP).
DEFENDSEC_TLS_SERVER_NAME=localhost
# Optional: enable iptables egress drop on isolate (requires iptables-nft).
# DEFENDSEC_ISOLATE_NET=1
# Optional extra FIM paths (colon-separated on Linux).
# DEFENDSEC_FIM_PATHS=/etc/hostname:/etc/resolv.conf
