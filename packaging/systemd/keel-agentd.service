# keel-agentd — endpoint agent
[Unit]
Description=Keel endpoint agent (mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/lib/keel-agent
ExecStart=/usr/local/bin/keel-agentd --server-http https://CONTROL_PLANE:47262 --server-grpc CONTROL_PLANE:47263 --enroll-secret-file /etc/keel/enroll-secret --state-dir /var/lib/keel-agent
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/keel-agent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
