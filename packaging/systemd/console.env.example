# Copy to /etc/defendsec/console.env and adjust.
NODE_ENV=production
# Behind defendsec-web, which serves HTTPS on 47261. This port is loopback
# only and is not reachable off the box.
PORT=47265
# Loopback only. defendsec-web terminates HTTPS in front of the console
# (roadmap 5.3), so the plain-HTTP port is not reachable off the box. Change
# this only if you are running your own reverse proxy on another host.
HOSTNAME=127.0.0.1
DATABASE_URL=postgres://defendsec:defendsec@127.0.0.1:5432/defendsec?sslmode=disable
DEFENDSEC_DATABASE_URL=postgres://defendsec:defendsec@127.0.0.1:5432/defendsec?sslmode=disable
DEFENDSEC_APID_ADMIN=http://127.0.0.1:47264
# DEFENDSEC_ADMIN_TOKEN=
DEFENDSEC_DOWNLOADS_DIR=/var/lib/defendsec/downloads
DEFENDSEC_DATA_DIR=/var/lib/defendsec
# The session cookie is marked Secure, because the console is served over
# HTTPS by default. Set false only alongside DEFENDSEC_TLS=off in an isolated
# lab — a Secure cookie is not sent over plain HTTP, so logging in would fail.
DEFENDSEC_COOKIE_SECURE=true
# Set behind a reverse proxy so Enroll emits the public download URL.
# DEFENDSEC_PUBLIC_CONSOLE_URL=https://defendsec.example.com
