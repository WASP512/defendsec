[Unit]
Description=DefendSec control plane (enroll, mTLS gRPC, signed commands)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=defendsec
Group=defendsec
# Copy packaging/systemd/apid.env.example → /etc/defendsec/apid.env
EnvironmentFile=-/etc/defendsec/apid.env
ExecStart=/usr/local/bin/defendsec-apid \
  -data-dir /var/lib/defendsec \
  -http-addr 0.0.0.0:47262 \
  -grpc-addr 0.0.0.0:47263 \
  -admin-addr 127.0.0.1:47264
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/defendsec

[Install]
WantedBy=multi-user.target
