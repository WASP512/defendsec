# Copy to /etc/defendsec/feeds.env. Read by `defendsec-feeds` (and by the
# defendsec-feeds.service unit). Anything already set in the real environment
# wins over this file. The database URL is NOT set here: the unit also reads
# /etc/defendsec/apid.env, so feeds always load into the database apid uses.
#
# defendsec-feeds downloads whole published files. It never sends a package
# name, host name or anything else about your fleet to anyone.

# Where downloaded feed files are kept (and what `export` bundles).
# DEFENDSEC_FEEDS_CACHE_DIR=/var/lib/defendsec/feeds

# Holds pki/control-ed25519.key, which signs bundles made by `export`.
# DEFENDSEC_DATA_DIR=/var/lib/defendsec

# Which feeds run. Default:
#   kev,epss,ubuntu-jammy,ubuntu-noble,debian,rhel-8,rhel-9,rocky-8,rocky-9,
#   almalinux-8,almalinux-9,suse-leap-16.0,suse-tumbleweed
# A Rocky or Alma host is only assessed when its own feed (rocky-N, almalinux-N)
# is enabled; rhel-N alone cannot say whether the rebuild has shipped a fix.
# `defendsec-feeds list` shows every feed this build knows. Trim this to what
# your fleet actually runs: each feed you drop saves a download and a database
# load. Ranges for a distro release you do not enable are never created.
# DEFENDSEC_FEEDS_ENABLED=kev,epss,ubuntu-jammy,ubuntu-noble,debian

# Debian releases to keep from the security tracker (codenames).
# DEFENDSEC_FEEDS_DEBIAN_RELEASES=bookworm,trixie

# OSV bulk exports for software the fleet runs OUTSIDE the system package
# manager. Off by default. Ecosystem names as OSV spells them. Each one adds a
# feed named osv-<lowercase ecosystem> that you must also list in
# DEFENDSEC_FEEDS_ENABLED, e.g. DEFENDSEC_FEEDS_ENABLED=kev,epss,debian,osv-pypi
# DEFENDSEC_FEEDS_OSV_ECOSYSTEMS=PyPI,npm

# Mirror a feed by overriding its URL: DEFENDSEC_FEEDS_URL_<NAME>, the feed name
# upper-cased with other characters as underscores. https only (http is accepted
# for loopback). A token in the query string is stripped from everything the
# service stores, logs, exports or serves.
# DEFENDSEC_FEEDS_URL_UBUNTU_JAMMY=https://mirror.example.net/ubuntu/com.ubuntu.jammy.usn.oval.xml.bz2

# Per-file download limit in bytes (default 4 GiB) and per-feed fetch timeout.
# DEFENDSEC_FEEDS_MAX_BYTES=4294967296
# DEFENDSEC_FEEDS_TIMEOUT=30m

# Air-gapped installs: PEM public keys, comma separated, whose signatures
# `defendsec-feeds import` accepts (the exporting install's
# <data-dir>/pki/control-ed25519.pub). This install's own control key is always
# trusted as well.
# DEFENDSEC_FEEDS_TRUSTED_KEYS=/etc/defendsec/feeds-trusted.pem
