# Copy to /etc/defendsec/apid.env and adjust.
DEFENDSEC_DATABASE_URL=postgres://defendsec:defendsec@127.0.0.1:5432/defendsec?sslmode=disable
# Extra hostname/IP SAN for the server certificate (your Fedora LAN name or IP).
DEFENDSEC_TLS_HOSTNAME=fedora
# DEFENDSEC_ADMIN_TOKEN=
# DEFENDSEC_VIEWER_TOKEN=
# DEFENDSEC_ALERT_RETENTION_DAYS=90
# DEFENDSEC_LIVE_QUERY_RETENTION_DAYS=30

# The MCP endpoint for AI agents (roadmap 4.1).
#
# Off unless set. An agent that connects here can read fleet state and propose
# responses; it can never sign one — every proposal is recorded unsigned and
# needs a human approval. Needs a configured database, because agent
# principals are stored there.
#
# DefendSec is the MCP server. It never calls a model and holds no API key.
# DEFENDSEC_MCP_ADDR=127.0.0.1:47266
#
# Only needed for a browser-based MCP client. Non-browser clients send no
# Origin header and need no entry here.
# DEFENDSEC_MCP_ORIGINS=https://console.example
