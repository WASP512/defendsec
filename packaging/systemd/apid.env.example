# Copy to /etc/defendsec/apid.env and adjust.
DEFENDSEC_DATABASE_URL=postgres://defendsec:defendsec@127.0.0.1:5432/defendsec?sslmode=disable
# Extra hostname/IP SAN for the server certificate (your Fedora LAN name or IP).
DEFENDSEC_TLS_HOSTNAME=fedora
# DEFENDSEC_ADMIN_TOKEN=
# DEFENDSEC_VIEWER_TOKEN=
# DEFENDSEC_ALERT_RETENTION_DAYS=90
# DEFENDSEC_LIVE_QUERY_RETENTION_DAYS=30

# The MCP endpoint for AI agents (roadmap 4.1).
#
# Off unless set. An agent that connects here can read fleet state and propose
# responses; it can never sign one — every proposal is recorded unsigned and
# needs a human approval. Needs a configured database, because agent
# principals are stored there.
#
# DefendSec is the MCP server. It never calls a model and holds no API key.
# DEFENDSEC_MCP_ADDR=127.0.0.1:47266
#
# Only needed for a browser-based MCP client. Non-browser clients send no
# Origin header and need no entry here.
# DEFENDSEC_MCP_ORIGINS=https://console.example

# First-run setup (creating the first administrator without the admin token).
# Open for this long after defendsec-apid starts, and only while no account
# exists. Restarting reopens it, which needs access to the server. Set to off
# to require the admin token for the first account.
# DEFENDSEC_SETUP_WINDOW=30m

# Single sign-on through an OpenID Connect provider (Entra ID, Okta, Google,
# Keycloak, Authentik...). Off unless DEFENDSEC_SSO_ISSUER is set. A partial
# configuration refuses to start. Local accounts and the admin token keep
# working alongside it, so a broken IdP never locks you out.
#
# Register DefendSec at the IdP with this redirect URL:
#   https://<console-host>:47261/api/sso/callback
#
# DEFENDSEC_SSO_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# DEFENDSEC_SSO_CLIENT_ID=
# DEFENDSEC_SSO_CLIENT_SECRET=
# DEFENDSEC_SSO_REDIRECT_URL=https://defendsec.example.com:47261/api/sso/callback
# DEFENDSEC_SSO_NAME=Microsoft
#
# Roles come only from these groups. Someone in neither is refused, not
# given a default role. Admin wins when a user is in both.
# DEFENDSEC_SSO_ADMIN_GROUPS=defendsec-admins
# DEFENDSEC_SSO_VIEWER_GROUPS=defendsec-viewers
# DEFENDSEC_SSO_GROUPS_CLAIM=groups

# --- Scale (roadmap 5.5) ---
# Postgres pool size for apid (default 20).
# DEFENDSEC_DB_MAX_CONNS=20
# Go profiler on a loopback address, for diagnosing load. Off by default.
# DEFENDSEC_PPROF_ADDR=127.0.0.1:6060

# --- Integrations (roadmap 5.6) ---
# Forwarding: syslog, cef, webhook, slack, teams, otlp, file. See OPERATIONS.md.
# DEFENDSEC_FORWARD=cef=tls://siem.example:6514,slack=https://hooks.slack.com/services/T/B/X#min=high,otlp=https://collector:4318
# Prometheus on another address. Non-loopback requires a token.
# DEFENDSEC_METRICS_ADDR=0.0.0.0:9464
# DEFENDSEC_METRICS_TOKEN=
# OpenTelemetry traces (standard variables).
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20token
# OTEL_TRACES_SAMPLER=traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
